{
  "name": "office-ai-copilot",
  "version": "1.0.0",
  "description": "Professional AI Copilot for Microsoft Office — Excel, Word, PowerPoint. Powered by NVIDIA NIM and multi-provider AI.",
  "author": "Office AI Copilot",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "start": "webpack serve --mode development",
    "start:excel": "npm run dev",
    "start:word": "npm run dev",
    "start:powerpoint": "npm run dev",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "validate:excel": "npx office-addin-manifest validate manifests/excel.xml",
    "validate:word": "npx office-addin-manifest validate manifests/word.xml",
    "validate:powerpoint": "npx office-addin-manifest validate manifests/powerpoint.xml"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.54.0",
    "@fluentui/react-icons": "^2.0.245",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.0",
    "rehype-raw": "^7.0.0"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.377",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-dev-certs": "^1.13.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.3",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
